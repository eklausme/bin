	}
	for (sort keys %bots) {
		next if ($bots{$_} == 0);
		#$sumBots += $bots{$_};
		printf(F "bot\t%d\t%.4f\t%.4f\t%.4f\t%s\n", $bots{$_}, 100 * $bots{$_} / $sumGood, 100 * $bots{$_} / $sumTotal, 100 * $bots{$_} / $sumBots, $_);
	}
	for (sort keys %domain) {
		next if ($domain{$_} == 0);
		#$sumDomain += $domain{$_};
		printf(F "domain\t%d\t%.4f\t%.4f\t%.4f\t%s\n", $domain{$_}, 100 * $domain{$_} / $sumGood, 100 * $domain{$_} / $sumTotal, 100 * $domain{$_} / $sumDomain, $_);
	}

	printf(F "badURL\t%d\t%.4f\t%.4f\n",$badURL, 100 * $badURL / $sumGood, 100 * $badURL / $sumTotal);
	printf(F "badReferer\t%d\t%.4f\t%.4f\n",$badReferer, 100 * $badReferer / $sumGood, 100 * $badReferer / $sumTotal);
	printf(F "emptyReferer\t%d\t%.4f\t%.4f\n",$emptyReferer, 100 * $emptyReferer / $sumGood, 100 * $emptyReferer / $sumTotal);
	printf(F "urlEqReferer\t%d\t%.4f\t%.4f\n",$urlEqReferer, 100 * $urlEqReferer / $sumGood, 100 * $urlEqReferer / $sumTotal);
	printf(F "Sum class A\t%d\t%.4f\t%.4f\n",$sumClassA, 100 * $sumClassA / $sumGood, 100 * $sumClassA / $sumTotal);
	printf(F "Sum class B\t%d\t%.4f\t%.4f\n",$sumClassB, 100 * $sumClassB / $sumGood, 100 * $sumClassB / $sumTotal);
	printf(F "Sum class C\t%d\t%.4f\t%.4f\n",$sumClassC, 100 * $sumClassC / $sumGood, 100 * $sumClassC / $sumTotal);
	printf(F "Sum IP\t%d\t%.4f\t%.4f\n",$sumIP, 100 * $sumIP / $sumGood, 100 * $sumIP / $sumTotal);
	printf(F "Sum bots\t%d\t%.4f\t%.4f\n",$sumBots, 100 * $sumBots / $sumGood, 100 * $sumBots / $sumTotal);
	printf(F "Empty UA\t%d\t%.4f\t%.4f\n",$emptyUA, 100 * $emptyUA / $sumGood, 100 * $emptyUA / $sumTotal);
	printf(F "smallUA(le3)\t%d\t%.4f\t%.4f\n",$smallUA, 100 * $smallUA / $sumGood, 100 * $smallUA / $sumTotal);
