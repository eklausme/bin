		printf(F "ClassA\t%d\t%.4f\t%.4f\t%.4f\t%s\n", $classA{$_}, 100 * $classA{$_} / $sumGood, 100 * $classA{$_} / $sumTotal, 100 * $classA{$_} / $sumClassA, $_);
